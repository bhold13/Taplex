rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function publicProfile(resourceData) {
      return resourceData.privacy.profile_visibility == "public";
    }

    match /users/{userId} {
      allow read, update: if owns(userId) || isAdmin();
      allow create: if owns(userId);
      allow delete: if isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if publicProfile(resource.data) || owns(resource.data.owner_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if owns(resource.data.owner_uid) || isAdmin();
      allow delete: if owns(resource.data.owner_uid) || isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if resource.data.visibility == "public" || owns(resource.data.owner_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if owns(resource.data.owner_uid) || isAdmin();
    }

    match /connections/{connectionId} {
      allow read: if owns(resource.data.requester_uid) || owns(resource.data.target_owner_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.requester_uid == request.auth.uid;
      allow update: if owns(resource.data.requester_uid) || owns(resource.data.target_owner_uid) || isAdmin();
      allow delete: if owns(resource.data.requester_uid) || isAdmin();
    }

    match /messages/{messageId} {
      allow read: if owns(resource.data.sender_uid) || owns(resource.data.recipient_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.sender_uid == request.auth.uid;
      allow update: if owns(resource.data.recipient_uid) || isAdmin();
      allow delete: if owns(resource.data.sender_uid) || owns(resource.data.recipient_uid) || isAdmin();
    }

    match /community_posts/{postId} {
      allow read: if resource.data.visibility == "public" || owns(resource.data.author_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.author_uid == request.auth.uid;
      allow update, delete: if owns(resource.data.author_uid) || isAdmin();
    }

    match /marketplace/{listingId} {
      allow read: if resource.data.is_active == true || owns(resource.data.seller_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.seller_uid == request.auth.uid;
      allow update, delete: if owns(resource.data.seller_uid) || isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.host_uid == request.auth.uid;
      allow update, delete: if owns(resource.data.host_uid) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.author_uid == request.auth.uid;
      allow update, delete: if owns(resource.data.author_uid) || isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.author_uid == request.auth.uid;
      allow update, delete: if owns(resource.data.author_uid) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if owns(resource.data.recipient_uid) || isAdmin();
      allow create: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if owns(resource.data.owner_uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if owns(resource.data.owner_uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /analytics/{analyticsId} {
      allow read: if owns(resource.data.owner_uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /nfc_tags/{tagId} {
      allow read: if owns(resource.data.owner_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if owns(resource.data.owner_uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /qr_codes/{qrCodeId} {
      allow read: if owns(resource.data.owner_uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if owns(resource.data.owner_uid) || isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporter_uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /audit_logs/{auditLogId} {
      allow read, write: if isAdmin();
    }

    match /recommendation_graph/{nodeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
